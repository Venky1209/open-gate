{
  "expo": {
    "name": "OpenGate",
    "slug": "opengate",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "android": {
      "package": "com.venkat.opengate",
      "usesCleartextTraffic": true,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withNetworkSecurityConfig"
    ],
    "scheme": "opengate",
    "extra": {
      "eas": {
        "projectId": "e95a35ca-1e0a-4f16-b422-b1551d2c5c1b"
      }
    }
  }
}
